{
  "name": "ownlish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:fsd": "steiger ./src",
    "check:style": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lib --ignore-filename-regex 'src/(commands/|lib\\.rs)' --summary-only --fail-under-lines 90 --fail-under-functions 90 --fail-under-regions 90"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/query-core": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@iconify-json/lucide": "^1.2.124",
    "@schalkneethling/stylelint-plugin-css-property-type-validator": "0.1.0-beta.1",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "~7.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
